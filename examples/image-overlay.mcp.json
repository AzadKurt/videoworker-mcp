{
  "inputs": ["YOUR_INPUT_0_FILE_ID", "YOUR_INPUT_1_FILE_ID"],
  "args": [
    "-i",
    "{{input:0}}",
    "-i",
    "{{input:1}}",
    "-filter_complex",
    "[1:v]scale=48:-1[image];[0:v][image]overlay=W-w-8:H-h-8[v]",
    "-map",
    "[v]",
    "-map",
    "0:a?",
    "-c:v",
    "libx264",
    "-preset",
    "fast",
    "-crf",
    "25",
    "-pix_fmt",
    "yuv420p",
    "-c:a",
    "aac",
    "-movflags",
    "+faststart",
    "{{output:0}}"
  ],
  "outputs": ["overlay.mp4"],
  "timeout_seconds": 10,
  "request_id": "GENERATE_A_UUID_ONCE_AND_KEEP_FOR_RETRIES"
}
