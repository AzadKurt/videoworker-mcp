{
  "inputs": ["YOUR_INPUT_0_FILE_ID", "YOUR_INPUT_1_FILE_ID"],
  "args": [
    "-i",
    "{{input:0}}",
    "-i",
    "{{input:1}}",
    "-filter_complex",
    "[0:v]scale=640:360:force_original_aspect_ratio=decrease,pad=640:360:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=30,setpts=PTS-STARTPTS[v0];[1:v]scale=640:360:force_original_aspect_ratio=decrease,pad=640:360:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=30,setpts=PTS-STARTPTS[v1];[v0][v1]concat=n=2:v=1:a=0[v]",
    "-map",
    "[v]",
    "-an",
    "-c:v",
    "libx264",
    "-preset",
    "fast",
    "-crf",
    "25",
    "-movflags",
    "+faststart",
    "{{output:0}}"
  ],
  "outputs": ["joined.mp4"],
  "timeout_seconds": 10,
  "request_id": "GENERATE_A_UUID_ONCE_AND_KEEP_FOR_RETRIES"
}
